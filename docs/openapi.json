{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Liq Research API",
    "version": "1.0",
    "description": "Application0.3.0/model2.0.0. Estimated entry-notional exposure; not exchange positions. Detailed field semantics and operational caps in API.md. Legacy /api aliases remain."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/api/v1/heatmap": {
      "get": {
        "summary": "Heatmap with versioned provenance and exact features",
        "parameters": [
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "okx",
              "enum": [
                "okx",
                "binance",
                "demo",
                "aggregate"
              ]
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTC"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "24h",
              "enum": [
                "12h",
                "24h",
                "3d",
                "7d",
                "30d",
                "90d",
                "180d",
                "1y",
                "2y"
              ]
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "pair",
              "enum": [
                "pair",
                "symbol"
              ]
            }
          },
          {
            "name": "asof",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "5m",
                "15m",
                "1h",
                "4h",
                "12h",
                "1d"
              ]
            }
          },
          {
            "name": "visible_bars",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 2,
              "maximum": 3000
            }
          },
          {
            "name": "replay",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "enum": [
                0,
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful versioned response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "409": {
            "description": "Replay span expired"
          },
          "503": {
            "description": "Data unavailable, worker limit or cooperative deadline reached"
          },
          "429": {
            "description": "Expensive-work admission limit reached; Retry-After supplied"
          }
        }
      }
    },
