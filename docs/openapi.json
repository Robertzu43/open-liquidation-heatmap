            }
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTC"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "24h",
              "enum": [
                "12h",
                "24h",
                "3d",
                "7d",
                "30d",
                "90d",
                "180d",
                "1y",
                "2y"
