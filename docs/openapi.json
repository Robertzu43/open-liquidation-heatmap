                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful versioned response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "409": {
            "description": "Replay span expired"
          },
          "503": {
            "description": "Data unavailable, worker limit or cooperative deadline reached"
          },
          "429": {
            "description": "Expensive-work admission limit reached; Retry-After supplied"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "summary": "Process configuration, scenarios, ranges and capabilities",
        "responses": {
          "200": {
            "description": "Server configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/levels": {
      "get": {
        "summary": "Display-bin leverage decomposition, not exact logical price cohorts",
        "parameters": [
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "okx",
              "enum": [
                "okx",
                "binance",
                "bybit",
                "demo",
                "aggregate"
              ]
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTC"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "24h",
              "enum": [
                "12h",
                "24h",
                "3d",
                "7d",
                "30d",
                "90d",
                "180d",
                "1y",
                "2y"
              ]
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "pair",
              "enum": [
                "pair",
                "symbol"
              ]
            },
            "description": "symbol combines OKX, Binance and Bybit for the base asset."
          },
          {
            "name": "asof",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Binance pair mode only."
          },
          {
            "name": "bar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "5m",
                "15m",
                "1h",
                "4h",
                "12h",
                "1d"
              ]
            },
            "description": "Binance pair mode only."
          },
          {
            "name": "visible_bars",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 2,
              "maximum": 3000
            }
          },
          {
            "name": "replay",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "t",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Bar-open Unix milliseconds from times"
          },
          {
            "name": "price",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Leverage tier amounts"
          },
          "400": {
            "description": "Invalid query"
          }
        }
      }
    },
    "/api/v1/replay": {
      "get": {
        "summary": "Load a bounded Binance replay span",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTC"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "24h",
              "enum": [
                "12h",
                "24h",
                "3d",
                "7d",
                "30d",
                "90d",
                "180d",
                "1y",
                "2y"
              ]
            }
          },
          {
            "name": "bar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "5m",
                "15m",
                "1h",
                "4h",
                "12h",
                "1d"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required unless span is given"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "span",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 63072000
            },
            "description": "Seconds to replay, ending at the newest bar Binance can serve (current when its live API answers, else the archive's newest bar). Not combined with from or to."
          }
        ],
        "responses": {
          "200": {
            "description": "Replay frame metadata"
          },
          "400": {
            "description": "Invalid range or request"
          },
          "503": {
            "description": "Unavailable or work budget exceeded"
          }
        }
      }
    },
    "/api/v1/context": {
      "get": {
        "summary": "Live funding and open-interest snapshot per venue (context, not a model input)",
        "parameters": [
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "okx",
              "enum": [
                "okx",
                "binance",
                "bybit",
                "demo",
                "aggregate"
              ]
            },
            "description": "demo is synthetic and never contacts an exchange"
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTC"
            },
            "description": "1-16 letter/digit base ticker, optionally followed by USDT"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "pair",
              "enum": [
                "pair",
                "symbol"
              ]
            },
            "description": "symbol (or exchange=aggregate) covers all live venues for the base asset"
          }
        ],
        "responses": {
          "200": {
            "description": "At least one venue answered, or demo. Failed venues have ok=false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request: validation or bounds failure"
          },
          "429": {
            "description": "busy: all expensive-request slots are occupied; Retry-After supplied"
          },
          "503": {
            "description": "source_unavailable when every live venue failed; also server_busy or deadline_exceeded"
          }
        },
        "description": "Live only: asof, bar or replay=1 returns 400 invalid_request."
      }
    },
    "/api/v1/liquidations": {
      "get": {
        "summary": "Observed recent OKX filled liquidation orders (exchange records, not model output)",
        "parameters": [
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "okx",
              "enum": [
                "okx",
                "binance",
                "bybit",
                "demo",
                "aggregate"
              ]
            },
            "description": "binance or bybit in pair mode returns available=false; aggregate uses OKX; demo is synthetic"
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTC"
            },
            "description": "1-16 letter/digit base ticker, optionally followed by USDT"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "pair",
              "enum": [
                "pair",
                "symbol"
              ]
            },
            "description": "symbol (or exchange=aggregate) covers all live venues for the base asset"
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "24h",
              "enum": [
                "12h",
                "24h",
                "3d",
                "7d",
                "30d",
                "90d",
                "180d",
                "1y",
                "2y"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed events, or available=false with a note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiquidationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request: validation or bounds failure"
          },
          "429": {
            "description": "busy: all expensive-request slots are occupied; Retry-After supplied"
          },
          "503": {
            "description": "Source unavailable, server_busy or deadline_exceeded"
          }
        },
        "description": "Live only: asof, bar or replay=1 returns 400 invalid_request."
      }
    },
    "/api/v1/watchlist": {
      "get": {
        "summary": "Nearest modeled liquidation clusters for up to six symbols",
        "parameters": [
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "okx",
              "enum": [
                "okx",
                "binance",
                "bybit",
                "demo",
                "aggregate"
              ]
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "24h",
              "enum": [
                "12h",
                "24h",
                "3d",
                "7d",
                "30d",
                "90d",
                "180d",
                "1y",
                "2y"
              ]
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "pair",
              "enum": [
                "pair",
                "symbol"
              ]
            },
            "description": "symbol (or exchange=aggregate) covers all live venues for the base asset"
          },
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "BTC,ETH,SOL"
              ]
            },
            "description": "Comma-separated base tickers, 1-6. Duplicates are dropped; items keep request order. Missing or empty returns 400."
          }
        ],
        "responses": {
          "200": {
            "description": "One item per symbol; a failed symbol has ok=false and an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request: validation or bounds failure"
          },
          "429": {
            "description": "busy: all expensive-request slots are occupied; Retry-After supplied"
          },
          "503": {
            "description": "server_busy or deadline_exceeded"
          }
        },
        "description": "Live only: asof, bar or replay=1 returns 400 invalid_request."
      }
    },
    "/healthz": {
      "get": {
        "summary": "Process health",
        "responses": {
          "200": {
            "description": "The process is running"
          },
          "503": {
            "description": "All connection workers are busy (server_busy)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResearchEnvelope": {
        "type": "object",
        "required": [
          "schema_version",
          "model_version",
          "data_fingerprint",
          "quality",
          "features",
          "feature_as_of",
          "exchange",
          "symbol",
          "as_of",
          "units",
          "time_semantics",
          "model_metadata",
          "market_context"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "model_version": {
            "type": "string"
          },
          "data_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "exchange": {
            "type": "string",
            "description": "okx, binance, bybit, demo or aggregate"
          },
          "symbol": {
            "type": "string"
          },
          "as_of": {
            "type": "integer"
          },
          "feature_as_of": {
            "type": "integer"
          },
          "quality": {
            "type": "object",
            "required": [
              "status",
              "synthetic",
              "stale",
              "coverage",
              "historical_availability"
            ],
            "properties": {
              "status": {
                "enum": [
                  "synthetic",
                  "stale",
                  "degraded",
                  "observed",
                  "unknown"
                ]
              },
              "synthetic": {
                "type": "boolean"
              },
              "stale": {
                "type": "boolean"
              },
              "historical_availability": {
                "enum": [
                  "known",
                  "unknown"
                ]
              }
            }
          },
          "features": {
            "type": "object"
          },
          "units": {
            "type": "object"
          },
          "time_semantics": {
            "type": "object"
          },
          "model_metadata": {
            "type": "object"
          },
          "market_context": {
            "$ref": "#/components/schemas/MarketContext"
          }
        }
      },
      "MarketContext": {
        "type": "object",
        "description": "Computed over the displayed window.",
        "properties": {
          "price_change_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "Percent change from the first to the last displayed close"
          },
          "oi_usd": {
            "type": [
              "number",
              "null"
            ],
            "description": "Last observed open interest in USD; summed across venues for aggregate"
          },
          "oi_change_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "Percent change from the first to the last observed USD open interest; also moves with price"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "observed_liquidations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "okx"
              ]
            ]
          },
          "watchlist_max_symbols": {
            "type": "integer",
            "examples": [
              6
            ]
          },
          "context_venues": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "okx",
                "binance",
                "bybit"
              ]
            ]
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "schema_version": {
            "const": "1.0"
          },
          "version": {
            "type": "string",
            "description": "Application version, e.g. 0.4.0"
          },
          "default": {
            "type": "object"
          },
          "exchanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "enum": [
                    "okx",
                    "binance",
                    "bybit",
                    "demo"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "live": {
                  "type": "boolean"
                }
              }
            }
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "mmr": {
            "type": "number"
          },
          "coins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          }
        }
      },
      "ContextVenue": {
        "type": "object",
        "required": [
          "exchange",
          "ok"
        ],
        "properties": {
          "exchange": {
            "type": "string",
